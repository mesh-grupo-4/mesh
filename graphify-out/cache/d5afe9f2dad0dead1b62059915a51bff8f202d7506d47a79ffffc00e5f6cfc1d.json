.tsx", "source_location": "L479"}, {"caller_nid": "live_handlerespondersolicitud", "callee": "(async () => {\r\n      try {\r\n        await responderSolicitud(solicitudId, decision)\r\n      } catch (e) {\r\n        meshAlert('No se pudo responder', mensajeDeError(e))\r\n      }\r\n    })", "source_file": "D:\\TESIS\\mesh\\frontend\\app\\viaje\\[viajeId]\\live.tsx", "source_location": "L494"}, {"caller_nid": "live_handlepublicaralerta", "callee": "(async () => {\r\n      const pos = await posicionActual()\r\n      try {\r\n        await publicarAlerta({\r\n          tipo,\r\n          // Vac\u00edo = sin mensaje: el tipo ya dice de qu\u00e9 se trata.\r\n          mensaje: mensaje.trim() || undefined,\r\n          lat: pos?.lat,\r\n          lng: pos?.lng,\r\n        })\r\n        setComponiendoAlerta(false)\r\n      } catch (e) {\r\n        meshAlert('No se pudo enviar la alerta', mensajeDeError(e))\r\n      }\r\n    })", "source_file": "D:\\TESIS\\mesh\\frontend\\app\\viaje\\[viajeId]\\live.tsx", "source_location": "L521"}, {"caller_nid": "live_iraalertas", "callee": "push", "source_file": "D:\\TESIS\\mesh\\frontend\\app\\viaje\\[viajeId]\\live.tsx", "source_location": "L539"}, {"caller_nid": "live_handlecenteronme", "callee": "(async () => {\r\n      try {\r\n        const pos = await Location.getCurrentPositionAsync({ accuracy: Location.Accuracy.Balanced })\r\n        mapRef.current?.focusOnCoordinate(pos.coords.latitude, pos.coords.longitude)\r\n      } catch {\r\n        const me = memberList.find((m) => m.usuarioId === userId)\r\n        if (me) mapRef.current?.focusOnCoordinate(me.lat, me.lng)\r\n      }\r\n    })", "source_file": "D:\\TESIS\\mesh\\frontend\\app\\viaje\\[viajeId]\\live.tsx", "source_location": "L549"}]}