{
  "name": "mesh-backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "predev": "npm run docs:bundle",
    "build": "npm run docs:bundle && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "pretest": "npm run docs:bundle",
    "docs:lint": "redocly lint openapi/openapi.yaml",
    "docs:bundle": "redocly bundle openapi/openapi.yaml -o src/docs/openapi.bundled.json",
    "docs:preview": "redocly preview-docs openapi/openapi.yaml",
    "postinstall": "prisma generate --generator client",
    "db:generate": "prisma generate --generator client",
    "db:erd": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": { "node": ">=22 <25" },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@redocly/cli": "^2.46.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "prisma-erd-generator": "^2.4.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
