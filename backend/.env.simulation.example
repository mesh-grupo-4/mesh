# Configuración del simulador de GPS (backend/scripts/simulate-trip.ts).
# Copiá este archivo a backend/.env.simulation y completá los valores.
# .env.simulation está en .gitignore: NO lo commitees.

# apiKey pública del proyecto Firebase. Es la misma que ya está en
# frontend/lib/firebase.ts (las apiKey web de Firebase no son secretas), pero
# se lee de acá para no hardcodearla en el script.
FIREBASE_WEB_API_KEY=

# Opcionales: por defecto http://localhost:3000
# SIM_API_URL=http://localhost:3000
# SIM_SOCKET_URL=http://localhost:3000

# Opcional: instancia propia de OSRM en vez del demo público.
# SIM_OSRM_URL=https://router.project-osrm.org

# Los uid de Firebase de los usuarios de prueba van en el JSON del escenario,
# en participantes[].userId. El script firma un custom token con las credenciales
# de servicio de backend/.env y lo canjea por un ID token; no hacen falta passwords.
