generator client {
  provider = "prisma-client-js"
}
generator erd {
  provider = "prisma-erd-generator"
  output   = "../DER.svg"
}

datasource db {
  provider = "postgresql"
}

enum RolMiembro {
  lider
  participante
}

enum TipoActividad {
  moto
  bici
  running
  trekking
  otro
}

enum EstadoViaje {
  planificado
  en_curso
  finalizado
}

enum CategoriaParada {
  kiosco
  combustible
  descanso
  gastronomia
  punto_control
  sanitario
  otro
}

/// Estado visible de un integrante en el mapa grupal (RN-037).
/// `posible_incidente` queda declarado para el motor de eventos (RN-036).
enum EstadoIntegranteViaje {
  en_movimiento
  detenido_voluntario
  posible_incidente
}

enum TipoParada {
  voluntaria
  incidente_detectado
}

enum EstadoSolicitudParada {
  pendiente
  aprobada
  rechazada
  cancelada
}

/// Tema de la alerta que crea el líder (RN-041). Distinto de `OrigenAlerta`,
/// que dice quién la generó.
enum TipoAlerta {
  parada
  combustible
  desvio
  peligro
  informacion
}

enum OrigenAlerta {
  lider
  sistema
}

/// RN-042: la gestión de estados es de otra US; acá todas nacen `activa`.
enum EstadoAlerta {
  activa
  pausada
  cancelada
  resuelta
}

enum GpsSource {
  live
  offline_sync
}

enum EstadoInvitacionGrupo {
  pendiente
  aceptada
  rechazada
}

enum EstadoAmistad {
  pendiente
  aceptada
  rechazada
}

enum EstadoViajeIntegrante {
  pendiente
  confirmado
  rechazado
  /// Abandonó el viaje en curso. Salida blanda: conserva su histórico y figura en el resumen.
  salido
}

enum OrigenViajeIntegrante {
  creador
  qr
  link
  grupo
  amigo
}

model Usuario {
  id                  String         @id @default(uuid()) @db.Uuid
  firebase_uid        String         @unique @map("firebase_uid")
  email               String         @unique
  nombre              String
  apellido            String?
  telefono            String?
  actividad_preferida TipoActividad? @map("actividad_preferida")
  push_token          String?        @map("push_token")

  grupos_liderados       Grupo[]            @relation("GrupoLider")
  membresias             GrupoMiembro[]
  viajes_creados         Viaje[]            @relation("ViajeCreador")
  participaciones_viaje  ViajeIntegrante[]
  registros_gps          RegistroGPS[]
  metricas_viaje         MetricaViaje[]
  ubicacion_viva         UbicacionViva?
  invitaciones_recibidas GrupoInvitacion[]  @relation("InvitacionesRecibidas")
  invitaciones_enviadas  GrupoInvitacion[]  @relation("InvitacionesEnviadas")
  amistades_solicitadas  Amistad[]          @relation("AmistadSolicitante")
  amistades_recibidas    Amistad[]          @relation("AmistadDestinatario")
  rutas_plantilla        RutaPlantilla[]
  paradas                Parada[]
  solicitudes_parada     SolicitudParada[]  @relation("SolicitudParadaSolicitante")
  solicitudes_resueltas  SolicitudParada[]  @relation("SolicitudParadaResolutor")
  alertas_creadas        Alerta[]           @relation("AlertaAutor")

  @@map("usuario")
}

model Grupo {
  id             String   @id @default(uuid()) @db.Uuid
  nombre         String
  fecha_creacion DateTime @default(now()) @map("fecha_creacion")
  lider_id       String   @map("lider_id") @db.Uuid

  lider                Usuario           @relation("GrupoLider", fields: [lider_id], references: [id], onDelete: Restrict)
  miembros             GrupoMiembro[]
  viajes               ViajeGrupo[]
  invitaciones_destino GrupoInvitacion[] @relation("InvitacionesDestino")
  invitaciones_origen  GrupoInvitacion[] @relation("InvitacionesOrigen")

  @@map("grupo")
}

model GrupoMiembro {
  grupo_id    String   @map("grupo_id") @db.Uuid
  usuario_id  String   @map("usuario_id") @db.Uuid
  rol         RolMiembro
  fecha_union DateTime @default(now()) @map("fecha_union")

  grupo   Grupo   @relation(fields: [grupo_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([grupo_id, usuario_id])
  @@map("grupo_miembro")
}

model GrupoInvitacion {
  id              String                @id @default(uuid()) @db.Uuid
  grupo_id        String                @map("grupo_id") @db.Uuid
  usuario_id      String                @map("usuario_id") @db.Uuid
  invitado_por_id String                @map("invitado_por_id") @db.Uuid
  grupo_origen_id String?               @map("grupo_origen_id") @db.Uuid
  estado          EstadoInvitacionGrupo @default(pendiente)
  created_at      DateTime              @default(now()) @map("created_at")

  grupo        Grupo   @relation("InvitacionesDestino", fields: [grupo_id], references: [id], onDelete: Cascade)
  grupo_origen Grupo?  @relation("InvitacionesOrigen", fields: [grupo_origen_id], references: [id], onDelete: Cascade)
  usuario      Usuario @relation("InvitacionesRecibidas", fields: [usuario_id], references: [id], onDelete: Cascade)
  invitado_por Usuario @relation("InvitacionesEnviadas", fields: [invitado_por_id], references: [id], onDelete: Cascade)

  @@unique([grupo_id, usuario_id])
  @@index([usuario_id, estado])
  @@map("grupo_invitacion")
}

model Amistad {
  id              String        @id @default(uuid()) @db.Uuid
  solicitante_id  String        @map("solicitante_id") @db.Uuid
  destinatario_id String        @map("destinatario_id") @db.Uuid
  estado          EstadoAmistad @default(pendiente)
  created_at      DateTime      @default(now()) @map("created_at")

  solicitante  Usuario @relation("AmistadSolicitante", fields: [solicitante_id], references: [id], onDelete: Cascade)
  destinatario Usuario @relation("AmistadDestinatario", fields: [destinatario_id], references: [id], onDelete: Cascade)

  @@unique([solicitante_id, destinatario_id])
  @@index([destinatario_id, estado])
  @@map("amistad")
}

model Viaje {
  id                 String      @id @default(uuid()) @db.Uuid
  creador_id         String      @map("creador_id") @db.Uuid
  nombre             String?
  es_grupal          Boolean     @map("es_grupal")
  tipo_actividad            TipoActividad @map("tipo_actividad")
  velocidad_esperada        Float         @map("velocidad_esperada")
  distancia_max_separacion  Int           @map("distancia_max_separacion")
  estado                    EstadoViaje   @default(planificado)
  fecha_programada DateTime    @map("fecha_programada")
  fecha_inicio_real  DateTime?   @map("fecha_inicio_real")
  fecha_fin_real     DateTime?   @map("fecha_fin_real")
  created_at         DateTime    @default(now()) @map("created_at")

  creador     Usuario           @relation("ViajeCreador", fields: [creador_id], references: [id], onDelete: Restrict)
  integrantes ViajeIntegrante[]
  grupos      ViajeGrupo[]

  ruta    Ruta?
  resumen ResumenViaje?
  registros_gps RegistroGPS[]
  ubicaciones_vivas UbicacionViva[]
  metricas MetricaViaje[]
  paradas Parada[]
  solicitudes_parada SolicitudParada[]
  alertas Alerta[]

  @@index([creador_id])
  @@map("viaje")
}

model UbicacionViva {
  usuario_id  String   @id @map("usuario_id") @db.Uuid
  viaje_id    String   @map("viaje_id") @db.Uuid
  lat         Float
  lng         Float
  precision_m Float?   @map("precision_m")
  updated_at  DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  viaje   Viaje   @relation(fields: [viaje_id], references: [id], onDelete: Cascade)

  @@index([viaje_id])
  @@map("ubicacion_viva")
}

model ViajeGrupo {
  viaje_id   String   @map("viaje_id") @db.Uuid
  grupo_id   String   @map("grupo_id") @db.Uuid
  created_at DateTime @default(now()) @map("created_at")

  viaje Viaje @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  grupo Grupo @relation(fields: [grupo_id], references: [id], onDelete: Cascade)

  @@id([viaje_id, grupo_id])
  @@index([grupo_id])
  @@map("viaje_grupo")
}

model ViajeIntegrante {
  viaje_id     String                @map("viaje_id") @db.Uuid
  usuario_id   String                @map("usuario_id") @db.Uuid
  estado       EstadoViajeIntegrante
  origen       OrigenViajeIntegrante
  created_at   DateTime              @default(now()) @map("created_at")
  fecha_salida DateTime?             @map("fecha_salida")

  viaje   Viaje   @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([viaje_id, usuario_id])
  @@index([usuario_id, estado])
  @@map("viaje_integrante")
}

model RegistroGPS {
  id          String    @id @default(uuid()) @db.Uuid
  viaje_id    String    @map("viaje_id") @db.Uuid
  usuario_id  String    @map("usuario_id") @db.Uuid
  lat         Float
  lng         Float
  precision_m Float?    @map("precision_m")
  timestamp   DateTime
  source      GpsSource @default(live)
  created_at  DateTime  @default(now()) @map("created_at")

  viaje   Viaje   @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([viaje_id, timestamp])
  @@index([usuario_id, timestamp])
  @@map("registro_gps")
}

model Ruta {
  id                   String  @id @default(uuid()) @db.Uuid
  viaje_id             String  @unique @map("viaje_id") @db.Uuid
  origen_lat           Float   @map("origen_lat")
  origen_lng           Float   @map("origen_lng")
  origen_nombre        String? @map("origen_nombre")
  destino_lat          Float   @map("destino_lat")
  destino_lng          Float   @map("destino_lng")
  destino_nombre       String? @map("destino_nombre")
  linestring_geojson   Json    @map("linestring_geojson")
  distancia_planeada_m Float?  @map("distancia_planeada_m")
  tiempo_estimado_seg  Int?    @map("tiempo_estimado_seg")

  viaje               Viaje               @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  paradas_intermedias ParadaIntermedia[]
  compartida          RutaCompartida?

  @@map("ruta")
}

/// Link privado de una ruta planificada (RN-085–088). Snapshot congelado al generar el token.
model RutaCompartida {
  id           String    @id @default(uuid()) @db.Uuid
  ruta_id      String?   @unique @map("ruta_id") @db.Uuid
  token        String    @unique @db.VarChar(64)
  snapshot     Json
  created_at   DateTime  @default(now()) @map("created_at")
  revocado_en  DateTime? @map("revocado_en")

  ruta       Ruta?           @relation(fields: [ruta_id], references: [id], onDelete: SetNull)
  plantillas RutaPlantilla[]

  @@map("ruta_compartida")
}

/// Copia independiente de una ruta compartida en el perfil del usuario.
model RutaPlantilla {
  id                   String        @id @default(uuid()) @db.Uuid
  usuario_id           String        @map("usuario_id") @db.Uuid
  ruta_compartida_id   String        @map("ruta_compartida_id") @db.Uuid
  nombre               String
  tipo_actividad       TipoActividad @map("tipo_actividad")
  origen_lat           Float         @map("origen_lat")
  origen_lng           Float         @map("origen_lng")
  origen_nombre        String?       @map("origen_nombre")
  destino_lat          Float         @map("destino_lat")
  destino_lng          Float         @map("destino_lng")
  destino_nombre       String?       @map("destino_nombre")
  linestring_geojson   Json          @map("linestring_geojson")
  distancia_planeada_m Float?        @map("distancia_planeada_m")
  tiempo_estimado_seg  Int?          @map("tiempo_estimado_seg")
  created_at           DateTime      @default(now()) @map("created_at")

  usuario         Usuario              @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  ruta_compartida RutaCompartida       @relation(fields: [ruta_compartida_id], references: [id], onDelete: Restrict)
  paradas         RutaPlantillaParada[]

  @@unique([usuario_id, ruta_compartida_id])
  @@index([usuario_id, created_at])
  @@map("ruta_plantilla")
}

model RutaPlantillaParada {
  id                String          @id @default(uuid()) @db.Uuid
  ruta_plantilla_id String          @map("ruta_plantilla_id") @db.Uuid
  orden             Int
  lat               Float
  lng               Float
  nombre            String?
  categoria         CategoriaParada @default(otro)

  plantilla RutaPlantilla @relation(fields: [ruta_plantilla_id], references: [id], onDelete: Cascade)

  @@unique([ruta_plantilla_id, orden])
  @@map("ruta_plantilla_parada")
}

model ParadaIntermedia {
  id         String          @id @default(uuid()) @db.Uuid
  ruta_id    String          @map("ruta_id") @db.Uuid
  orden      Int
  lat        Float
  lng        Float
  nombre     String?
  categoria  CategoriaParada @default(otro)

  ruta Ruta @relation(fields: [ruta_id], references: [id], onDelete: Cascade)

  @@index([ruta_id, orden])
  @@map("parada_intermedia")
}

model ResumenViaje {
  id                   String   @id @default(uuid()) @db.Uuid
  viaje_id             String   @unique @map("viaje_id") @db.Uuid
  duracion_segundos    Int?     @map("duracion_segundos")
  distancia_planeada_m Float?   @map("distancia_planeada_m")
  distancia_real_m     Float?   @map("distancia_real_m")
  cantidad_paradas     Int      @default(0) @map("cantidad_paradas")
  generado_en          DateTime @default(now()) @map("generado_en")

  viaje Viaje @relation(fields: [viaje_id], references: [id], onDelete: Cascade)

  @@map("resumen_viaje")
}

/// Métricas individuales por integrante, calculadas desde registro_gps al finalizar (RN-061).
/// Parada registrada durante el viaje (US1/US3). Mientras `fin` es null el
/// integrante figura como `detenido_voluntario` en el mapa grupal: el estado se
/// deriva de acá, no se duplica en ubicacion_viva.
model Parada {
  id              String           @id @default(uuid()) @db.Uuid
  viaje_id        String           @map("viaje_id") @db.Uuid
  usuario_id      String           @map("usuario_id") @db.Uuid
  lat             Float
  lng             Float
  tipo            TipoParada       @default(voluntaria)
  categoria       CategoriaParada?
  inicio          DateTime         @default(now())
  fin             DateTime?
  /// RN-036: el integrante confirmó que está bien tras un posible incidente.
  confirmado_bien Boolean?         @map("confirmado_bien")

  viaje   Viaje   @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([viaje_id, inicio])
  @@index([usuario_id, inicio])
  @@map("parada")
}

/// Solicitud de parada de un integrante al líder (US2, RN-044).
model SolicitudParada {
  id              String                @id @default(uuid()) @db.Uuid
  viaje_id        String                @map("viaje_id") @db.Uuid
  solicitante_id  String                @map("solicitante_id") @db.Uuid
  lat             Float?
  lng             Float?
  motivo          String?
  estado          EstadoSolicitudParada @default(pendiente)
  resuelta_por_id String?               @map("resuelta_por_id") @db.Uuid
  created_at      DateTime              @default(now()) @map("created_at")
  resolved_at     DateTime?             @map("resolved_at")

  viaje        Viaje    @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  solicitante  Usuario  @relation("SolicitudParadaSolicitante", fields: [solicitante_id], references: [id], onDelete: Cascade)
  resuelta_por Usuario? @relation("SolicitudParadaResolutor", fields: [resuelta_por_id], references: [id], onDelete: SetNull)

  @@index([viaje_id, estado])
  @@index([solicitante_id, created_at])
  @@map("solicitud_parada")
}

/// Alerta del viaje (US1, RN-040/041/043). Hoy solo las crea el líder; el enum
/// `OrigenAlerta` deja lugar al motor de eventos (desvíos, atrasos, incidentes).
model Alerta {
  id            String       @id @default(uuid()) @db.Uuid
  viaje_id      String       @map("viaje_id") @db.Uuid
  creada_por_id String?      @map("creada_por_id") @db.Uuid
  tipo          TipoAlerta
  origen        OrigenAlerta @default(lider)
  mensaje       String
  /// RN-043: dónde estaba quien la creó, para ubicarla en el mapa.
  lat           Float?
  lng           Float?
  estado        EstadoAlerta @default(activa)
  created_at    DateTime     @default(now()) @map("created_at")
  resolved_at   DateTime?    @map("resolved_at")

  viaje      Viaje    @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  creada_por Usuario? @relation("AlertaAutor", fields: [creada_por_id], references: [id], onDelete: SetNull)

  @@index([viaje_id, created_at])
  @@map("alerta")
}

model MetricaViaje {
  id                     String   @id @default(uuid()) @db.Uuid
  viaje_id               String   @map("viaje_id") @db.Uuid
  usuario_id             String   @map("usuario_id") @db.Uuid
  distancia_m            Float    @map("distancia_m")
  tiempo_movimiento_seg  Int      @map("tiempo_movimiento_seg")
  velocidad_promedio_kmh Float?   @map("velocidad_promedio_kmh")
  velocidad_maxima_kmh   Float?   @map("velocidad_maxima_kmh")
  generado_en            DateTime @default(now()) @map("generado_en")

  viaje   Viaje   @relation(fields: [viaje_id], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([viaje_id, usuario_id])
  @@index([usuario_id])
  @@map("metrica_viaje")
}
