---
import Rueda from '../components/Rueda.astro'
import Rotulo from '../components/Rotulo.astro'
import { COMPETIR } from '../content/copy'
---

<section class="comp" id="competir" data-seccion="competir" data-competir data-cinta-seccion>
  <div class="comp__a seccion tema-crema">
    <div class="envoltura comp__grilla">
      <div>
        <p class="etiqueta">{COMPETIR.etiqueta}</p>
        <h2 class="h2" data-titulo>{COMPETIR.h2a}</h2>
        <p class="lead comp__lead">{COMPETIR.primero}</p>
      </div>
      <figure class="comp__tabla" data-comp-tabla>
        <figcaption class="mono">{COMPETIR.tablaTitulo}</figcaption>
        <ol>
          {COMPETIR.tabla.map(([quien, dato], i) => (
            <li class:list={['comp__fila', { 'comp__fila--gonza': quien === 'Gonza' }]} data-comp-fila>
              <span class="mono comp__pos">{i + 1}</span>
              <Rueda r={11} muesca class="comp__rueda" />
              <strong>{quien}</strong>
              <span class="mono comp__dato">{dato}</span>
            </li>
          ))}
        </ol>
        <p class="comp__gonza">{COMPETIR.gonza}</p>
        <Rotulo />
      </figure>
    </div>
  </div>

  <div class="comp__b seccion" data-comp-moto>
    <div class="envoltura">
      <div class="comp__rueda-moto" data-comp-rueda aria-hidden="true">
        <svg viewBox="-74 -74 148 148" width="148" height="148">
          <circle r="60" fill="none" stroke="var(--moto-acento)" stroke-width="28" />
          <g fill="none" stroke="var(--moto-acento)" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="-23" cy="13" r="9" />
            <circle cx="23" cy="13" r="9" />
            <path d="M23 13 L13 -8 L7 -17 L15 -18 M-23 13 L-6 8" />
            <path d="M-21 -3 L-4 -3 C -1 -11 9 -12 13 -7 L8 6 L-7 8 Z" fill="var(--moto-acento)" />
          </g>
        </svg>
      </div>
      <div class="comp__apagada" data-comp-apagada aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <h2 class="h2 comp__h2b">{COMPETIR.h2b}</h2>
      <div class="comp__manifiesto">
        {COMPETIR.manifiesto.map((l) => <p data-comp-linea>{l}</p>)}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .comp { position: relative; }
  .comp__a { padding-bottom: clamp(72px, 9vw, 140px); }
  .comp__grilla { display: grid; gap: 32px; }
  .comp__lead { margin-top: 20px; color: var(--tinta); }
  .comp__tabla { padding: 22px; border-radius: var(--r-tarjeta); background: var(--blanco); border: 1px solid var(--linea); box-shadow: var(--sombra); }
  .comp__tabla figcaption { color: var(--tinta-suave); margin-bottom: 10px; letter-spacing: 0; }
  .comp__fila { display: grid; grid-template-columns: 26px 22px 1fr auto; align-items: center; gap: 10px; padding-block: 10px; border-top: 1px solid var(--linea); }
  .comp__pos, .comp__dato { letter-spacing: 0; }
  .comp__dato { color: var(--tinta-suave); }
  .comp__fila--gonza strong { color: var(--naranja-texto); }
  .comp__gonza { font-style: italic; font-weight: 700; margin-block: 12px 8px; }

  .comp__apagada { display: grid; gap: 8px; max-width: 420px; margin-bottom: 32px; opacity: .1; }
  .comp__apagada span { height: 10px; border-radius: 5px; background: #fff; }
  .comp__apagada span:nth-child(2) { width: 84%; }
  .comp__apagada span:nth-child(3) { width: 68%; }
  .comp__apagada span:nth-child(4) { width: 52%; }
  .comp__b { z-index: 2; background: var(--moto-fondo); color: #fff; padding-block: clamp(96px, 14vw, 200px); }
  .comp__rueda-moto { width: 148px; margin-bottom: 36px; line-height: 0; }
  .comp__h2b { color: var(--moto-acento); }
  .comp__manifiesto { margin-top: 28px; display: grid; gap: 8px; font-family: var(--f-display); font-size: var(--t-h3); line-height: 1.15; font-weight: 700; letter-spacing: -.02em; max-width: 26ch; }

  @media (min-width: 900px) {
    .comp__grilla { grid-template-columns: 1.15fr 1fr; gap: 64px; align-items: center; }
  }
</style>
