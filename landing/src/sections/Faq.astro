---
import AvisoSeguridad from '../components/AvisoSeguridad.astro'
import { FAQ, FAQ_TELEFONOS, FAQ_TITULO } from '../content/copy'
import { textoTelefonos } from '../config/descarga'

export function preguntasFaq(): [string, string][] {
  return [...FAQ, [FAQ_TELEFONOS, textoTelefonos()]] as [string, string][]
}
const preguntas = preguntasFaq()
---

<section class="faq seccion topo tema-crema" id="faq" data-seccion="faq" data-cinta-seccion>
  <div class="envoltura faq__grilla">
    <div>
      <p class="etiqueta">{FAQ_TITULO.etiqueta}</p>
      <h2 class="h2" data-titulo>{FAQ_TITULO.h2}</h2>
    </div>
    <div>
      <div class="faq__lista">
        {preguntas.map(([p, r]) => (
          <details class="faq__item" data-faq={p}>
            <summary>{p}<span class="faq__marca" aria-hidden="true"></span></summary>
            <p class="faq__resp">{r}</p>
          </details>
        ))}
      </div>
      <AvisoSeguridad class="faq__aviso" />
    </div>
  </div>
</section>

<style is:global>
  .faq__grilla { display: grid; gap: 36px; }
  .faq__item { border-top: 1px solid var(--tinta); interpolate-size: allow-keywords; }
  .faq__item:last-child { border-bottom: 1px solid var(--tinta); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; padding-block: 14px; font-family: var(--f-display); font-size: 1.375rem; font-weight: 700; line-height: 1.15; cursor: pointer; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__marca { position: relative; flex: none; width: 22px; height: 22px; }
  .faq__marca::before, .faq__marca::after { content: ''; position: absolute; top: 9px; left: 0; width: 22px; height: 4px; border-radius: 2px; background: var(--naranja-texto); transition: transform var(--d-corta) var(--e-suave); }
  .faq__marca::after { transform: rotate(90deg); }
  .faq__item[open] .faq__marca::after { transform: none; }
  .faq__item::details-content { block-size: 0; overflow: clip; transition: block-size var(--d-corta) var(--e-suave), content-visibility var(--d-corta) allow-discrete; }
  .faq__item[open]::details-content { block-size: auto; }
  .faq__resp { padding-bottom: 20px; max-width: 62ch; }
  .faq__aviso { margin-top: 24px; }

  @media (min-width: 900px) {
    .faq__grilla { grid-template-columns: 1fr 1.5fr; gap: 64px; align-items: start; }
  }
</style>
