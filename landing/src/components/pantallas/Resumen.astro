---
import Icono from '../Icono.astro'
---

<div class="app pant-res">
  <p class="app-sub"><Icono nombre="flag" tam={16} /> Salida terminada</p>
  <p class="app-titulo">Altas Cumbres</p>
  <div class="pant-res__datos mono">
    <p><span data-contar="86">86</span> km <small>Distancia</small></p>
    <p><span data-contar="5">5</span> h <span data-contar="20">20</span> <small>Tiempo</small></p>
    <p><span data-contar="3">3</span> <small>Paradas</small></p>
  </div>
  <span class="app-boton">Listo</span>
</div>

<style is:global>
  .pant-res .app-sub { display: flex; align-items: center; gap: 6px; }
  .pant-res__datos { display: grid; gap: 10px; margin-block: auto; letter-spacing: 0; }
  .pant-res__datos p { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px; padding: 12px 14px; border-radius: 16px; background: var(--noche-2); font-size: 28px; font-weight: 700; line-height: 1.1; }
  .pant-res__datos small { font-family: var(--f-texto); font-size: 15px; font-weight: 400; color: var(--hueso-suave); margin-left: auto; }
</style>
