---
import MapaApp from './MapaApp.astro'
import AlertaDesvio from './AlertaDesvio.astro'

interface Props {
  conAlerta?: boolean
}
const { conAlerta = true } = Astro.props
---

<div class="pant-mapa">
  <MapaApp />
  <p class="pant-mapa__estado"><span class="pant-mapa__punto"></span> En curso · 6 en el mapa</p>
  {conAlerta && <div class="pant-mapa__alerta" data-mapa-alerta><AlertaDesvio /></div>}
</div>

<style is:global>
  .pant-mapa { position: relative; flex: 1; min-height: 0; }
  .pant-mapa .mapa-app { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .pant-mapa__estado { position: absolute; top: 22px; left: 50%; translate: -50% 0; white-space: nowrap; display: flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; background: var(--noche-2); color: var(--hueso); }
  .pant-mapa__punto { width: 9px; height: 9px; border-radius: 50%; background: #4FB477; }
  .pant-mapa__alerta { position: absolute; left: 10px; right: 10px; bottom: 12px; }
</style>
