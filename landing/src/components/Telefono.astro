---
// Marco genérico: no imita ningún modelo reconocible (plan, 4.6).
interface Props {
  /** Descripción para lector de pantalla. Sin ella, el contenido se lee como interfaz real. */
  etiqueta?: string
  moto?: boolean
  class?: string
  [dato: `data-${string}`]: unknown
}
const { etiqueta, moto = false, class: clase, ...resto } = Astro.props
const a11y = etiqueta ? { role: 'img' as const, 'aria-label': etiqueta } : {}
---

<div class:list={['tel', { 'tel--moto': moto }, clase]} {...a11y} {...resto}>
  <div class="tel__pantalla">
    <slot />
  </div>
</div>

<style is:global>
  .tel {
    --tel-ancho: 320px;
    width: min(var(--tel-ancho), 100%);
    aspect-ratio: 320 / 640;
    flex: none;
    padding: 10px;
    border-radius: var(--r-telefono);
    background: #24211E;
    box-shadow: 0 0 0 1px #3A3633, var(--sombra);
  }
  .tel__pantalla {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 34px;
    background: var(--noche);
    color: var(--hueso);
    font-size: 15px;
    line-height: 1.3;
  }
  .tel--moto { background: #000; box-shadow: 0 0 0 2px #333, var(--sombra); }
  .tel--moto .tel__pantalla { background: var(--moto-fondo); color: #fff; }

  /* Piezas compartidas por las pantallas de la app. */
  .app { display: flex; flex-direction: column; gap: 12px; flex: 1; min-height: 0; padding: 26px 16px 16px; }
  .app-titulo { font-size: 21px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
  .app-sub { color: var(--hueso-suave); }
  .app-boton { display: flex; align-items: center; justify-content: center; min-height: 50px; border-radius: 12px; background: var(--coral); color: var(--tinta); font-weight: 700; text-align: center; padding: 8px 12px; }
  .app-chip { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 12px; background: var(--noche-2); border: 1px solid #2E2E2E; }
  .app-chip--on { border-color: var(--coral); color: #F2A79B; background: rgba(215, 102, 85, .18); }
  .app-aviso { display: flex; align-items: flex-start; gap: 10px; padding: 12px; border-radius: 16px; background: var(--noche-2); border: 1px solid #3A3A3A; box-shadow: 0 8px 24px rgba(0, 0, 0, .45); line-height: 1.25; }
  .app-aviso strong { display: block; }
  .app-aviso .icono { flex: none; margin-top: 1px; }
</style>
