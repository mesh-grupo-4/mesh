# Sin secretos: todas estas variables terminan en el HTML público.
# En producción se cargan como variables de GitHub Actions; definí solo las que existan.

# Descarga. Sin valor, el botón muestra el estado "próximamente".
PUBLIC_ANDROID_URL=
PUBLIC_APK_URL=
PUBLIC_IOS_URL=
PUBLIC_LISTA_ESPERA_URL=

# Analítica sin cookies, compatible con la API de eventos de Plausible.
# Sin ambas variables, no se envía nada.
PUBLIC_ANALITICA_ENDPOINT=
PUBLIC_ANALITICA_DOMINIO=
